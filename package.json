{
  "name": "hls-player",
  "displayName": "HLS Player",
  "version": "1.1.0",
  "author": "paulcoding",
  "description": "Play HLS (.m3u8) and DASH (.mpd) streams in a clean full-page player. Keep a library, resume where you left off, skip intros",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "firefox-extension",
    "hls",
    "m3u8",
    "dash",
    "mpd",
    "video.js",
    "react",
    "vite"
  ],
  "engines": {
    "node": ">=14.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:firefox": "BROWSER=firefox NODE_ENV=development vite build --mode development --minify false",
    "build": "vite build",
    "build:firefox": "BROWSER=firefox vite build",
    "preview": "vite preview",
    "fmt": "prettier --write '**/*.{jsx,js,tsx,ts,json,css,scss,md}'",
    "zip": "pnpm build && node src/zip.js",
    "zip:firefox": "export BROWSER=firefox && pnpm build && node src/zip.js"
  },
  "dependencies": {
    "@videojs/http-streaming": "3.17.5",
    "@xmldom/xmldom": "0.8.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "video.js": "^8.24.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@eslint/js": "^9.20.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/chrome": "^0.0.304",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.13",
    "@vitejs/plugin-react": "^4.1.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "glob": "^10.3.10",
    "globals": "^15.15.0",
    "gulp": "^4.0.2",
    "gulp-zip": "^6.0.0",
    "postcss": "^8.5.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "vite": "^5.4.10",
    "vite-plugin-svgr": "^4.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
